# Mailbridge example environment file.
# Copy to .env and fill in your real values:  cp example.env .env
# .env is gitignored — never commit real credentials.

PORT=6245
DOMAIN=example.com
FROM_EMAIL=no-reply@example.com
FROM_NAME=Mailbridge
MY_EMAIL=admin@example.com
DEFAULT=MAILEROO SMTP2GO

# Provider credentials (fill in the ones you use; DEFAULT lists active senders in order)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.example.com
SENDPULSE_CLIENT_ID=your-sendpulse-client-id
SENDPULSE_CLIENT_SECRET=your-sendpulse-client-secret
SMTP2GO_API_KEY=your-smtp2go-api-key
POSTMARK_TOKEN=your-postmark-token
MAILTRAP_TOKEN=your-mailtrap-token
MAILEROO_API_KEY=your-maileroo-api-key

# Comma-separated alias@domain:destination@domain routing rules
ROUTES=alias@example.com:destination@example.net,info@example.com:owner@example.net

# Comma-separated addresses allowed to trigger privileged actions
PRIVILEGED_SENDERS=admin@example.com

# Secret used to authenticate inbound webhooks
WEBHOOK_KEY=change-me-webhook-secret

# Address emails are forwarded from (forwardemail integration)
FORWARD_FROM_EMAIL=forward@example.com

# Local state store
DB_PATH=/tmp/data.json

# Brother printer email-to-print integration (optional)
# true  = print@ addresses go to the Brother printer
# false = print@ addresses are handled as normal inbound mail
PRINT_ENABLED=true
BROTHER_PRINTER_EMAIL=
